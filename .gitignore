# Public repository allowlist: new root-level files remain local by default.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/docs/
!/experiment_compiler/
!/lammps/
!/scripts/
!/specs/
!/tests/
!/reports/
!/visualization/
!/results/

# Local environment, caches, generated files, and private material.
**/__pycache__/
**/*.pyc
/.venv/
/.cache/
/.codex/
/tmp/
/generated/
/api.py
/scripts/create_project_intro.js

# Precomputed datasets needed for the first public demo.
/results/*
!/results/diffusion_pressure/
!/results/diffusion_pressure_preview/
/results/diffusion_pressure/*
!/results/diffusion_pressure/run_manifest.json
!/results/diffusion_pressure/summary.json
!/results/diffusion_pressure/diffusion_vs_pressure.csv
!/results/diffusion_pressure/diffusion_vs_pressure.png
!/results/diffusion_pressure/p_0p10/
!/results/diffusion_pressure/p_0p20/
!/results/diffusion_pressure/p_0p30/
!/results/diffusion_pressure/p_0p40/
!/results/diffusion_pressure/p_0p50/
/results/diffusion_pressure/p_*/**
!/results/diffusion_pressure/p_*/msd.csv
!/results/diffusion_pressure/p_*/thermo.csv
/results/diffusion_pressure_preview/*
!/results/diffusion_pressure_preview/run_manifest.json
!/results/diffusion_pressure_preview/p_0p10/
!/results/diffusion_pressure_preview/p_0p20/
!/results/diffusion_pressure_preview/p_0p30/
!/results/diffusion_pressure_preview/p_0p40/
!/results/diffusion_pressure_preview/p_0p50/
/results/diffusion_pressure_preview/p_*/**
!/results/diffusion_pressure_preview/p_*/trajectory.lammpstrj
