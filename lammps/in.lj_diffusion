# Three-dimensional tracer-diffusion example for visualization.
# Type 1 and type 2 have identical physics; color is the only distinction.
# All quantities use reduced Lennard-Jones units.

clear
units           lj
dimension       3
boundary        f f f
atom_style      atomic

variable        temperature index 1.5
variable        density index 0.3
variable        cells index 5
variable        seed index 20260921
variable        equil_steps index 5000
variable        prod_steps index 20000
variable        dump_interval index 250

lattice         fcc ${density}
region          box block 0 ${cells} 0 ${cells} 0 ${cells} units lattice
create_box      2 box
create_atoms    1 box
mass            1 1.0
mass            2 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_coeff      1 2 1.0 1.0 2.5
pair_coeff      2 2 1.0 1.0 2.5
pair_modify     shift yes
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# Hard reflecting walls on all six faces of the simulation box.
fix             confinement all wall/reflect xlo EDGE xhi EDGE ylo EDGE yhi EDGE zlo EDGE zhi EDGE units box

timestep        0.005
velocity        all create ${temperature} ${seed} mom yes rot no dist gaussian

thermo          500
thermo_style    custom step atoms temp press pe ke etotal density
thermo_modify   flush yes

# Equilibrate a uniform gas first, then assign tracer labels by position.
fix             preparation all nvt temp ${temperature} ${temperature} $(100.0*dt)
run             ${equil_steps}
unfix           preparation
velocity        all scale ${temperature}

variable        midpoint equal 0.5*(xlo+xhi)
variable        split equal ${midpoint}
region          left block INF ${split} INF INF INF INF units box
region          right block ${split} INF INF INF INF INF units box
set             region left type 1
set             region right type 2

reset_timestep  0
fix             production all nve

variable        sample_step equal step
variable        sample_temp equal temp
variable        sample_press equal press
fix             observables all print ${dump_interval} "${sample_step},${sample_temp},${sample_press}" file thermo.csv screen no title "step,temp,pressure"

dump            trajectory all custom ${dump_interval} trajectory.lammpstrj id type x y z xu yu zu vx vy vz
dump_modify     trajectory sort id

run             ${prod_steps}
write_data      final.data
